  {
    "id": "intro_tower",
    "file": "audio/en/intro_tower.wav",
    "category": "voice",
    "locale": "en",
    "text": "Welcome to Posture Tower. Sit comfortably and relax your shoulders. Set the downward angle limit, duration, and grace period, then place the tower where you want it. Look straight ahead, calibrate, and begin. The tower leans as you look down and straightens when you return upright. Staying over the limit beyond the grace period topples the tower and ends the challenge. You can end the session at any time, but cannot pause it. Stop if you feel discomfort.",
    "voice": "en-US-GuyNeural",
    "gender": "Male",
    "rate": "-6%",
    "pitch": "-2Hz",
    "sampleRate": 24000,
    "channels": 1,
